{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbis Scriptor",
  "version": "0.5.0",
  "identifier": "com.racso1230.orbisscriptor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orbis Scriptor",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Oscar Freeman",
    "homepage": "https://orbisscriptor.co.uk",
    "copyright": "Copyright (c) 2026 Oscar Freeman",
    "category": "Productivity",
    "shortDescription": "Local-first fantasy worldbuilding",
    "longDescription": "Orbis Scriptor is a local-first desktop app for fantasy worldbuilding: maps, lore, timelines, characters and notes, stored in a folder on your own machine.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "section": "graphics",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDQzU3MUIxMDA4NzBGREEKUldUYUQ0Y0FzWEhGREdzc3R1bmpHNmp5cE8zSDNIL2tMeGtGRkdFUUhwakI5eklPdkYzRjF2dEoK",
      "endpoints": [
        "https://github.com/Racso1230/orbis-scriptor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
